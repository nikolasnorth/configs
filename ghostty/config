# font
font-family = JetBrainsMono Nerd Font
font-size = 13
# uncomment to disable ligatures
# font-feature = -liga,-calt,-dlig

# theme
theme = Catppuccin Mocha
window-colorspace = display-p3

# transparency
background-opacity = 0.88
background-blur = 25

# window: minimal chrome, no titlebar
macos-titlebar-style = hidden
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = auto
confirm-close-surface = false
quit-after-last-window-closed = true
maximize = true
resize-overlay = never

# cursor: follows the theme instead of a fixed color
cursor-style = block
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background
mouse-hide-while-typing = true
# keep the block cursor everywhere (no shell-driven bar cursor)
shell-integration-features = no-cursor

# macos
macos-option-as-alt = true

# bell: no alert sound or Dock bounce; herdr toasts already surface agent
# alerts (🔔 title prefix stays on by default)
bell-features = no-system,no-attention

# fix shift+enter for claude code
keybind = shift+enter=text:\x1b\r
