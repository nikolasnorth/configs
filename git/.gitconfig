# use neovim for commit messages
# use delta for diffs
[core]
    editor = nvim
    pager = delta

[color]
    ui = auto

[alias]
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order

[delta]
    navigate = true
    side-by-side = false
    line-numbers = true
    syntax-theme = gruvbox-dark

# highlight moved lines in diffs
[diff]
    colorMoved = default

# auto setup remote tracking on first push
# git push just works, no need for git push -u origin branch
[push]
    autoSetupRemote = true

# remove stale remote branches on fetch
[fetch]
    prune = true

# sort branches by most recent commit
[branch]
    sort = -committerdate
