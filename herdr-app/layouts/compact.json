{
  "id": "root",
  "cloned_from": {
    "name": "minimal",
    "version": "0.1.11"
  },
  "type": "row",
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "content": {
        "mod": "compact-tabs"
      },
      "size": {
        "px": 240
      },
      "min": 120,
      "max": 400,
      "window_drag": true
    },
    {
      "id": "right",
      "type": "column",
      "children": [
        {
          "id": "strip",
          "type": "block",
          "content": {
            "mod": "minimal-strip"
          },
          "size": {
            "px": 0
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "minimal-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "#17191c",
                  "border": {
                    "width": 1,
                    "color": "#24272b"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#33363b"
                  },
                  "radius": 10,
                  "gap": 6,
                  "lone": true
                }
              }
            }
          ],
          "padding": 6
        }
      ],
      "resizable": false
    }
  ],
  "background": "#131619",
  "theme": "graphite",
  "colors": {
    "accent": "#3b82f6",
    "background": "#131619",
    "border": "#25282c",
    "dim": "#8b8f95",
    "foreground": "#e8e9eb",
    "hover": "#ffffff0d",
    "muted": "#a9adb3",
    "raised": "#202225",
    "selection": "#264f78",
    "surface": "#17191c",
    "terminal_foreground": "#e6e7e9"
  },
  "terminal_padding": [
    8,
    10
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "font_size": 12,
  "terminal_menu": "comment-menu"
}
